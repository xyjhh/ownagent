# Express HTTP API 监听端口。
API_PORT=8787
# 允许访问 API 和 WebSocket 的前端来源，多个来源可按项目配置拆分处理。
WEB_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# Supabase 项目地址，仅用于服务端访问。
SUPABASE_URL=http://127.0.0.1:54321
# Supabase service-role 密钥，只能放在后端环境变量中，绝不能返回浏览器。
SUPABASE_SERVICE_ROLE_KEY=
# OwnAgent 使用的独立 PostgreSQL schema，用于和其他项目的数据隔离。
SUPABASE_DB_SCHEMA=ownagent
# PostgreSQL 直连地址，用于 LISTEN/NOTIFY、LangGraph checkpoint 和迁移相关能力。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# 当前用于签发和验证 access JWT 的密钥，生产环境必须使用至少 32 位随机值。
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
# JWT 密钥轮换时用于验证旧 token 的上一代密钥，没有旧密钥时留空。
AUTH_JWT_PREVIOUS_SECRET=
# JWT 的 issuer，签发和校验时必须一致。
AUTH_JWT_ISSUER=ownagent
# JWT 的 audience，签发和校验时必须一致。
AUTH_JWT_AUDIENCE=ownagent-api
# Access token 有效期，例如 15m 表示 15 分钟。
ACCESS_TOKEN_TTL=15m
# Refresh token 有效期，例如 30d 表示 30 天。
REFRESH_TOKEN_TTL=30d
# Access token HttpOnly Cookie 的名称。
AUTH_COOKIE_ACCESS_NAME=ownagent_access
# Refresh token HttpOnly Cookie 的名称。
AUTH_COOKIE_REFRESH_NAME=ownagent_refresh
# 是否为 Cookie 启用 Secure；HTTPS 生产环境应设为 true，本地 HTTP 通常为 false。
AUTH_COOKIE_SECURE=false
# Cookie 的 SameSite 策略，通常使用 lax。
AUTH_COOKIE_SAMESITE=lax

# 首个管理员/所有者账号邮箱，仅由 auth:bootstrap 初始化脚本读取。
ADMIN_EMAIL=owner@example.com
# 首个管理员/所有者账号密码，仅由 auth:bootstrap 初始化时读取，不要提交到版本库。
ADMIN_PASSWORD=

# DeepSeek API 密钥，只在服务端使用。
DEEPSEEK_API_KEY=
# DeepSeek 兼容 API 的基础地址。
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 使用的 DeepSeek 模型名称。
DEEPSEEK_MODEL=deepseek-chat

# Embedding 服务的 OpenAI 兼容 API 地址。
EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
# Embedding 服务使用的模型名称。
EMBEDDING_MODEL=Qwen3-Embedding-0.6B
# 本地 Qwen3 Reranker 服务地址。
RERANK_URL=http://127.0.0.1:8001
# 调用 DeepSeek、Embedding、Reranker 的超时时间，单位为毫秒。
MODEL_TIMEOUT_MS=30000

# Redis 连接地址。
REDIS_URL=redis://127.0.0.1:6379
# Redis 最大内存，达到上限后按 REDIS_MAXMEMORY_POLICY 处理。
REDIS_MAXMEMORY=512mb
# Redis 内存淘汰策略；可靠任务队列必须使用 noeviction。
REDIS_MAXMEMORY_POLICY=noeviction
# Dead Letter Stream 的最大保留条数（近似裁剪）。
REDIS_DEAD_LETTER_MAXLEN=10000
# Outbox 发布失败后的首次重试延迟，单位为毫秒。
REDIS_OUTBOX_RETRY_BASE_MS=1000
# Outbox 单次退避重试的最大延迟，单位为毫秒。
REDIS_OUTBOX_RETRY_MAX_MS=60000
# Pending 消息被其他 Worker 接管前的最小空闲时间，单位为毫秒。
REDIS_RECLAIM_IDLE_MS=300000
# Agent run 任务使用的 Redis Stream。
REDIS_STREAM_AGENT=ownagent:agent-runs
# 文档导入任务使用的 Redis Stream。
REDIS_STREAM_INGEST=ownagent:document-ingest
# 超过最大重试次数后写入的死信 Redis Stream。
REDIS_STREAM_DEAD_LETTER=ownagent:dead-letter
# 审批、追问、打断等 Agent 控制命令使用的 Redis Stream。
REDIS_STREAM_CONTROLS=ownagent:agent-controls
# Worker 使用的 Redis Consumer Group 名称。
REDIS_CONSUMER_GROUP=ownagent-workers
# 单个 Worker 实例同时处理的任务数量上限。
WORKER_CONCURRENCY=4
CONTROL_CONCURRENCY=2
REDIS_STREAM_DOCUMENT_INGEST=ownagent:document-ingest
REDIS_STREAM_DOCUMENT_DEAD_LETTER=ownagent:document-dead-letter
REDIS_STREAM_MEMORY=ownagent:memory-tasks
REDIS_STREAM_MEMORY_DEAD_LETTER=ownagent:memory-dead-letter
INGEST_CONCURRENCY=2
INGEST_MAX_ATTEMPTS=5
INGEST_TIMEOUT_MS=600000
DOCUMENT_MAX_FILE_SIZE_BYTES=52428800
DOCUMENT_UPLOAD_PROTOCOL=tus
DOCUMENT_UPLOAD_CHUNK_SIZE_BYTES=16777216
DOCUMENT_UPLOAD_EXPIRES_MS=86400000
DOCUMENT_UPLOAD_MAX_ACTIVE_PER_USER=3
DOCUMENT_DOWNLOAD_URL_EXPIRES_SECONDS=600
DOCUMENT_UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/markdown,text/plain
# Supabase Storage S3 multipart 配置。Secret 只能放在后端，不发送给浏览器。
SUPABASE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_REGION=local
MEMORY_CONCURRENCY=2
MEMORY_MAX_ATTEMPTS=5
MEMORY_TIMEOUT_MS=120000
MEMORY_EMBEDDING_ENABLED=true
MEMORY_AUTO_SAVE_LOW_RISK=true
MEMORY_CONFIRM_SENSITIVE=true
MEMORY_MAX_ITEMS_PER_CONTEXT=20
CONVERSATION_RECENT_MESSAGES=12
CONVERSATION_SUMMARY_THRESHOLD=30
AGENT_MAX_EVIDENCE=8
AGENT_MAX_CONTEXT_TOKENS=12000
# 知识库候选召回模式；hybrid 使用关键词/全文和向量双路召回。
RETRIEVAL_MODE=hybrid
SUPERVISOR_MODEL=deepseek-chat
SUPERVISOR_TIMEOUT_MS=10000
SUPERVISOR_MAX_RETRIES=1
SUPERVISOR_CONFIDENCE_THRESHOLD=0.65
# Worker shutdown grace period before active tasks are aborted.
WORKER_SHUTDOWN_TIMEOUT_MS=30000
# 单个任务允许的最大执行尝试次数。
WORKER_MAX_ATTEMPTS=5

# 是否启用 Langfuse 链路追踪。
LANGFUSE_TRACING=true
# Langfuse 公钥。
LANGFUSE_PUBLIC_KEY=
# Langfuse 私钥，只能放在服务端环境变量中。
LANGFUSE_SECRET_KEY=
# Langfuse 服务地址。
LANGFUSE_BASE_URL=http://127.0.0.1:3001
# Langfuse 项目名称。
LANGFUSE_PROJECT=ownagent
# 是否允许记录经过控制的内容调试信息，生产环境建议保持 false。
LANGFUSE_DEBUG_CONTENT=false

# WebSocket 心跳间隔，单位为毫秒。
WS_HEARTBEAT_INTERVAL_MS=30000
# 单个 WebSocket 消息允许的最大字节数。
WS_MAX_FRAME_BYTES=256000
# API 进程允许建立的最大 WebSocket 连接数。
WS_MAX_CONNECTIONS=1000
