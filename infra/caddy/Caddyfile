{
  auto_https off
  admin off
}

:80 {
  encode gzip

  @ownagent path /api/* /ws /health/*
  handle @ownagent {
    reverse_proxy api:8787
  }

  @supabase path /auth/v1/* /rest/v1/* /graphql/v1 /storage/v1/* /realtime/v1/* /functions/v1/*
  handle @supabase {
    reverse_proxy kong:8000
  }

  @login path /login /login/*
  handle @login {
    reverse_proxy login-ssr:3000 {
      @upstream_error status 5xx
      handle_response @upstream_error {
        reverse_proxy frontend:80
      }
    }
  }

  handle {
    reverse_proxy frontend:80
  }
}
