{
  "name": "ownagent-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:document-worker": "tsx watch src/document-worker.ts",
    "dev:memory-worker": "tsx watch src/memory-worker.ts",
    "start:all": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1",
    "start:all:build": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Build",
    "start:all:docker": "powershell -ExecutionPolicy Bypass -File scripts/start-all.ps1 -Docker -Build",
    "stop:all": "powershell -ExecutionPolicy Bypass -File scripts/stop-all.ps1",
    "stop:all:docker": "powershell -ExecutionPolicy Bypass -File scripts/stop-all.ps1 -Docker",
    "models:start": "powershell -ExecutionPolicy Bypass -File scripts/start-models.ps1",
    "models:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-models.ps1",
    "models:status": "powershell -ExecutionPolicy Bypass -File scripts/model-status.ps1",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "auth:bootstrap": "tsx src/scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@supabase/supabase-js": "^2.57.4",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "^6.1.0",
    "langfuse": "^3.38.6",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0",
    "pino": "^9.7.0",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "supertest": "^7.1.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
